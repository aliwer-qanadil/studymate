# Copy this file to .env and fill it in. .env is git-ignored, so secrets stay on your computer.
# Every value is optional for a local run with `docker compose up --build`.
# For staging and production, set the same names in the cloud platform's settings (see docs/DEPLOY.md).

# ---- Email for login codes ----
# MAIL_PROVIDER: auto (default), smtp, brevo or log.
#   auto  - smtp when MAIL_USERNAME is set, otherwise log
#   log   - no email; codes appear in `docker compose logs backend | grep "Login code"`. Local use only.
#   smtp  - any SMTP server. For Gmail, MAIL_PASSWORD is a Gmail "App password", not your normal password.
#   brevo - Brevo's HTTPS email API, for hosts that block SMTP (most free cloud plans do)
MAIL_PROVIDER=
MAIL_USERNAME=
MAIL_PASSWORD=
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# Sender address. Defaults to MAIL_USERNAME; required for brevo (a sender verified in Brevo).
# MAIL_FROM=
# BREVO_API_KEY=
# The older names GMAIL_USER and GMAIL_APP_PASSWORD still work instead of MAIL_USERNAME / MAIL_PASSWORD.

# ---- Database login used by the db and backend containers (defaults to studymate/studymate) ----
# DB_USER=studymate
# DB_PASSWORD=studymate

# ---- App ----
# Demo students and groups for a first run. Set to false for a real deployment.
# DEMO_DATA=true
# Time zone for "today" and "already started" checks
# APP_TIME_ZONE=Asia/Almaty
# Extra sites allowed to call the API directly from a browser (not needed behind the frontend's nginx)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Ports on your computer. Change one if "port is already allocated" appears ----
# FRONTEND_PORT=3000
# BACKEND_PORT=8080
# DB_PORT=5434
