        <mxCell id="note" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#FDFBF7;strokeColor=#E9A87C;spacing=8;fontSize=12;" value="&lt;b&gt;StudyMate — ERD (database design, Milestone 1)&lt;/b&gt;&lt;br&gt;Design of the planned database; not every table is implemented in the code yet.&lt;br&gt;&lt;br&gt;PK primary key · FK foreign key · UQ unique&lt;br&gt;1 = one · N = many (crow&#39;s foot at the N side)&lt;br&gt;Grey = lookup tables, navy = transactional tables&lt;br&gt;Normalised to 3NF. Physical name of USER: &lt;i&gt;users&lt;/i&gt; (reserved word in PostgreSQL)." vertex="1">
          <mxGeometry height="150" width="400" x="20" y="600" as="geometry" />
        </mxCell>
